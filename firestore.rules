rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function anaYoneticiler() {
      return [
        'ADMIN@gmail.com'
      ];
    }

    function girisli() {
      return request.auth != null && request.auth.token.email != null;
    }
    function eposta() {
      return request.auth.token.email.lower();
    }
    function kayitYolu() {
      return /databases/$(database)/documents/users/$(eposta());
    }
    function anaYonetici() {
      return girisli() && eposta() in anaYoneticiler();
    }
    function aktifKayit() {
      return girisli() && exists(kayitYolu()) && get(kayitYolu()).data.active == true;
    }
    function yonetici() {
      return anaYonetici() || (aktifKayit() && get(kayitYolu()).data.role == 'admin');
    }
    function calisan() {
      return yonetici() || aktifKayit();
    }

    match /users/{userId} {
      allow read: if yonetici() || (girisli() && eposta() == userId);
      allow write: if yonetici();
    }

    match /receipts/{id} {
      allow create: if calisan();
      allow read, update, delete: if yonetici();
    }

    match /products/{id} {
      allow read: if calisan();
      allow write: if yonetici();
    }
    match /hotels/{id} {
      allow read: if calisan();
      allow write: if yonetici();
    }
    match /settings/{id} {
      allow read: if calisan();
      allow write: if yonetici();
    }
  }
}
